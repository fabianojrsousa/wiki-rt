---
interface Props { titulo: string; descricao?: string; imagem?: string; }
const { titulo, descricao, imagem = '/og.png' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagemUrl = new URL(imagem, Astro.site).href;
const descricaoPadrao = 'Referência da Reforma Tributária do Consumo: IBS, CBS, normas, prazos, apuração assistida e APIs, com fonte oficial.';
const rota = Astro.url.pathname;
const atual = (p: string) => (rota === p || rota.startsWith(p + '/') ? 'page' : undefined);
const tituloCompleto = titulo === 'Radar RT' ? 'Radar RT' : `${titulo} — Radar RT`;
import '../styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#06091a" />
    <meta name="description" content={descricao ?? descricaoPadrao} />
    <link rel="canonical" href={canonica} />
    <!-- Open Graph (WhatsApp, Teams, Slack, LinkedIn): og:image é obrigatório, sem ele o card some -->
    <meta property="og:site_name" content="Radar RT" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao ?? descricaoPadrao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao ?? descricaoPadrao} />
    <meta name="twitter:image" content={imagemUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" type="application/rss+xml" title="Radar RT" href="/rss.xml" />
    <!-- Previne flash de tema errado -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('tema');
        if (!t) t = 'escuro';
        document.documentElement.dataset.tema = t;
      })();
    </script>
  </head>
  <body>

    <!-- ── Background animado ── -->
    <div class="bg-aura" aria-hidden="true">
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
      <div class="bg-orb bg-orb-3"></div>
      <div class="bg-orb bg-orb-4"></div>
    </div>

    <!-- ── Cabeçalho fixo ── -->
    <header class="cabecalho" role="banner">
      <div id="progresso-barra" aria-hidden="true"></div>
      <div class="cabecalho-inner">

        <a class="marca" href="/" aria-label="Radar RT — início">
          <!-- tags que aparecem quando o radar detecta -->
          <span class="radar-tag radar-tag-sap">SAP</span>
          <span class="radar-tag radar-tag-erp">IMPOSTOS</span>
          <span class="radar-tag radar-tag-reforma">Reforma</span>
          <svg class="marca-icone" viewBox="0 0 40 40" width="42" height="42" aria-hidden="true" fill="none">
            <defs>
              <radialGradient id="rg" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.25"/>
                <stop offset="100%" stop-color="#60a5fa" stop-opacity="0"/>
              </radialGradient>
            </defs>
            <!-- anéis estáticos -->
            <circle cx="20" cy="20" r="19" fill="rgba(6,9,26,.85)" stroke="rgba(96,165,250,.28)" stroke-width="1"/>
            <circle cx="20" cy="20" r="13.5" stroke="rgba(96,165,250,.18)" stroke-width="0.75"/>
            <circle cx="20" cy="20" r="8"    stroke="rgba(96,165,250,.18)" stroke-width="0.75"/>
            <!-- blips de detecção (sincronizados com a varredura) -->
            <circle class="radar-blip radar-blip-sap"     cx="35" cy="14" r="1.2" fill="#60a5fa"/>
            <circle class="radar-blip radar-blip-erp"     cx="8"  cy="31" r="1.2" fill="#60a5fa"/>
            <circle class="radar-blip radar-blip-reforma" cx="4"  cy="18" r="1.2" fill="#60a5fa"/>
            <!-- varredura rotacionando -->
            <g class="radar-sweep">
              <path d="M20,20 L33.5,12 A13.5,13.5 0 0,0 20,6.5 Z" fill="rgba(96,165,250,.14)"/>
              <line x1="20" y1="20" x2="33.5" y2="12" stroke="#60a5fa" stroke-width="1.5" stroke-linecap="round"/>
              <circle class="radar-ping" cx="29.5" cy="13.5" r="4.5" fill="rgba(96,165,250,.22)"/>
              <circle cx="29.5" cy="13.5" r="2.2" fill="#60a5fa"/>
            </g>
            <!-- ponto central -->
            <circle class="radar-centro" cx="20" cy="20" r="1.8" fill="#93c5fd"/>
          </svg>
          <span class="marca-texto">
            <span class="marca-sup">RADAR</span>
            <span class="marca-nome">RT</span>
          </span>
        </a>

        <nav class="nav-wrapper" id="nav-wrapper" role="navigation" aria-label="Navegação principal">
          <ul class="nav">
            <li><a href="/conceitos"          aria-current={atual('/conceitos')}          class="nav-destaque">Conceito</a></li>
            <li><a href="/normas"             aria-current={atual('/normas')}             class="nav-destaque">Normas</a></li>
            <li><a href="/apuracao-assistida" aria-current={atual('/apuracao-assistida')} class="nav-destaque">Apuração Assistida</a></li>
            <li><a href="/apuracao-cbs"       aria-current={atual('/apuracao-cbs')}       class="nav-destaque">API's</a></li>
            <li><a href="/obrigacoes-2027"    aria-current={atual('/obrigacoes-2027')}    class="nav-destaque">Reforma x Obrigações</a></li>
            <li><a href="/contabilizacao"     aria-current={atual('/contabilizacao')}     class="nav-destaque">Contabilização</a></li>
            <li class="nav-dropdown-pai">
              <button class="nav-dropdown-btn nav-destaque" aria-expanded="false" aria-haspopup="true">
                RT x SAP
                <svg class="nav-dropdown-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
              <ul class="nav-dropdown" role="menu">
                <li><a href="/sap"       aria-current={atual('/sap')}       role="menuitem">Impacto da Reforma no seu sistema SAP</a></li>
                <li><a href="/situacoes" aria-current={atual('/situacoes')} role="menuitem">O que muda no SAP</a></li>
              </ul>
            </li>
          </ul>
        </nav>

        <div class="nav-acoes">
          <button class="btn-busca" id="btn-abrir-busca" aria-label="Buscar (Ctrl+K)" title="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            Buscar <kbd>Ctrl K</kbd>
          </button>

          <button class="btn-icone" id="btn-tema" aria-label="Alternar tema" title="Tema claro/escuro">
            <svg id="icone-lua" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg id="icone-sol" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
              <circle cx="12" cy="12" r="4"/>
              <line x1="12" y1="2"  x2="12" y2="4"/>
              <line x1="12" y1="20" x2="12" y2="22"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="2"  y1="12" x2="4"  y2="12"/>
              <line x1="20" y1="12" x2="22" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </button>

          <button class="btn-icone btn-busca-mobile" id="btn-abrir-busca-mobile" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </button>

          <button class="btn-icone btn-menu" id="btn-menu"
                  aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-wrapper">
            <svg id="icone-menu" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <svg id="icone-fechar" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6"  y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

      </div>
    </header>

    <!-- ── Menu mobile (fora do header para escapar do backdrop-filter containing block) ── -->
    <div class="menu-mobile" id="menu-mobile" aria-label="Menu de navegação">
      <ul class="menu-mobile-lista">
        <li><a href="/"               aria-current={rota === '/' ? 'page' : undefined}>Início</a></li>
        <li><a href="/conceitos"          aria-current={atual('/conceitos')}>Conceito</a></li>
        <li><a href="/normas"             aria-current={atual('/normas')}>Normas</a></li>
        <li><a href="/apuracao-assistida" aria-current={atual('/apuracao-assistida')}>Apuração Assistida</a></li>
        <li><a href="/apuracao-cbs"       aria-current={atual('/apuracao-cbs')}>API's</a></li>
        <li><a href="/obrigacoes-2027"    aria-current={atual('/obrigacoes-2027')}>Reforma x Obrigações</a></li>
        <li><a href="/contabilizacao"     aria-current={atual('/contabilizacao')}>Contabilização</a></li>
        <li class="menu-mobile-secao">RT x SAP</li>
        <li><a href="/sap"       aria-current={atual('/sap')}       class="menu-mobile-sub">Impacto da Reforma no seu sistema SAP</a></li>
        <li><a href="/situacoes" aria-current={atual('/situacoes')} class="menu-mobile-sub">O que muda no SAP</a></li>
        <li><a href="/linha-do-tempo" aria-current={atual('/linha-do-tempo')}>Linha do tempo</a></li>
        <li><a href="/quiz"            aria-current={atual('/quiz')}>Quiz</a></li>
        <li><a href="/podcasts"        aria-current={atual('/podcasts')}>Podcasts</a></li>
        <li><a href="/glossario"       aria-current={atual('/glossario')}>Glossário</a></li>
      </ul>
    </div>

    <!-- ── Modal de busca ── -->
    <div class="modal-overlay" id="modal-busca" role="dialog" aria-modal="true" aria-label="Busca rápida">
      <div class="modal">
        <div class="modal-cabecalho">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input id="campo-busca" type="search"
                 placeholder="Buscar normas, conceitos, marcos…"
                 autocomplete="off" spellcheck="false" />
        </div>
        <div class="modal-resultados" id="modal-resultados">
          <p class="modal-vazio">Digite para buscar…</p>
        </div>
        <div class="modal-rodape">
          <span><kbd>↵</kbd> selecionar</span>
          <span><kbd>Esc</kbd> fechar</span>
        </div>
      </div>
    </div>

    <!-- ── Conteúdo ── -->
    <div class="area-conteudo">
      <main id="conteudo-principal" data-pagefind-body><slot /></main>

      <footer class="rodape">
        <div class="rodape-info">
          <p>
            Informação pública com fonte oficial citada. Não é consultoria tributária.
            Consulte um profissional habilitado para situações concretas.
          </p>
          <p class="rodape-colab">Colaboradores: Fabiano Sousa &nbsp;·&nbsp; Idelvan Vasconcelos &nbsp;·&nbsp; Felipe Andrade</p>
        </div>
        <a class="rodape-rss" href="/rss.xml" aria-label="Feed RSS">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/>
            <circle cx="5" cy="19" r="1"/>
          </svg>
          RSS
        </a>
      </footer>
    </div>

    <!-- ── Navegação inferior (mobile) ── -->
    <nav class="nav-inferior" aria-label="Navegação principal mobile">
      <ul class="nav-inferior-lista">
        <li>
          <a class="nav-inf-item" href="/" aria-current={rota === '/' ? 'page' : undefined}>
            <span class="nav-inf-icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </span>
            <span>Início</span>
          </a>
        </li>
        <li>
          <a class="nav-inf-item nav-inf-destaque" href="/sap" aria-current={atual('/sap')}>
            <span class="nav-inf-icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </span>
            <span>RT x SAP</span>
          </a>
        </li>
        <li>
          <a class="nav-inf-item" href="/linha-do-tempo" aria-current={atual('/linha-do-tempo')}>
            <span class="nav-inf-icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </span>
            <span>Timeline</span>
          </a>
        </li>
        <li>
          <a class="nav-inf-item" href="/normas" aria-current={atual('/normas')}>
            <span class="nav-inf-icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </span>
            <span>Normas</span>
          </a>
        </li>
        <li>
          <button class="nav-inf-item" id="btn-busca-nav-inf" aria-label="Abrir busca">
            <span class="nav-inf-icon-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
            </span>
            <span>Buscar</span>
          </button>
        </li>
      </ul>
    </nav>

    <!-- ── Botão voltar ao topo ── -->
    <button id="topo" aria-label="Voltar ao topo" title="Voltar ao topo">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m18 15-6-6-6 6"/>
      </svg>
    </button>

    <style>
      /* ── Animações do logo radar ── */
      .radar-sweep {
        transform-origin: 20px 20px;
        animation: radar-girar 4s linear infinite;
      }

      @keyframes radar-girar {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }

      .radar-ping {
        transform-origin: 29.5px 13.5px;
        animation: radar-ping 4s ease-out infinite;
      }

      @keyframes radar-ping {
        0%   { transform: scale(1);   opacity: .55; }
        65%  { transform: scale(3);   opacity: 0;   }
        100% { transform: scale(3);   opacity: 0;   }
      }

      .radar-centro {
        transform-origin: 20px 20px;
        animation: radar-pulso 2s ease-in-out infinite;
      }

      @keyframes radar-pulso {
        0%, 100% { opacity: 1;   transform: scale(1);    }
        50%       { opacity: .4; transform: scale(1.5);  }
      }

      /* ── Colaboradores ── */
      .rodape-info { flex: 1; min-width: 0; }

      .rodape-colab {
        margin: .35rem 0 0;
        font-size: var(--t-sm);
        color: var(--tinta-fraca, #475569);
      }

      /* ── Tags de detecção ── */
      .marca { position: relative; overflow: visible; }

      .radar-tag {
        position: absolute;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #93c5fd;
        background: rgba(6,9,26,.92);
        border: 1px solid rgba(96,165,250,.5);
        border-radius: 3px;
        padding: 2px 5px;
        opacity: 0;
        pointer-events: none;
        white-space: nowrap;
        z-index: 20;
        box-shadow: 0 0 8px rgba(96,165,250,.25);
      }

      /* ciclo de 12s: cada tag ocupa 4s do ciclo, nunca aparecem juntas */
      .radar-tag-sap     { top: 4px;  left: -2px;  animation: radar-tag-flash 12s ease-out infinite; animation-delay: 0s; }
      .radar-tag-erp     { top: 28px; left: -16px; animation: radar-tag-flash 12s ease-out infinite; animation-delay: -8s; }
      .radar-tag-reforma { top: 4px;  left: -14px; animation: radar-tag-flash 12s ease-out infinite; animation-delay: -4s; }

      @keyframes radar-tag-flash {
        0%    { opacity: 0; transform: scale(.8) translateY(2px); }
        4%    { opacity: 1; transform: scale(1.05) translateY(0); }
        8%    { opacity: .95; transform: scale(1); }
        28%   { opacity: .6; }
        33%   { opacity: 0; }   /* some antes dos próximos 4s */
        100%  { opacity: 0; }
      }

      /* ── Blips no SVG (mesmo ciclo 12s) ── */
      .radar-blip { opacity: 0; }
      .radar-blip-sap     { animation: radar-blip 12s ease-out infinite; animation-delay: 0s; }
      .radar-blip-erp     { animation: radar-blip 12s ease-out infinite; animation-delay: -8s; }
      .radar-blip-reforma { animation: radar-blip 12s ease-out infinite; animation-delay: -4s; }

      @keyframes radar-blip {
        0%   { opacity: 0; }
        4%   { opacity: 1; }
        28%  { opacity: .5; }
        33%  { opacity: 0; }
        100% { opacity: 0; }
      }

      /* ── Ênfase permanente no logo ── */
      .marca-sup {
        font-size: .75rem !important;
        letter-spacing: .2em !important;
        color: #93c5fd !important;
        text-shadow: 0 0 10px rgba(96,165,250,.5);
      }

      .marca-nome {
        font-size: 1.9rem !important;
        filter: drop-shadow(0 0 6px rgba(96,165,250,.35));
        animation: rt-radar-glow 4s ease-in-out infinite;
      }

      @keyframes rt-radar-glow {
        0%, 74%  { filter: drop-shadow(0 0 6px rgba(96,165,250,.35)); }
        84%      { filter: drop-shadow(0 0 12px rgba(96,165,250,.7)) brightness(1.15); }
        92%      { filter: drop-shadow(0 0 22px rgba(96,165,250,1))  brightness(1.3); }
        100%     { filter: drop-shadow(0 0 6px rgba(96,165,250,.35)); }
      }

      @media (prefers-reduced-motion: reduce) {
        .radar-sweep, .radar-ping, .radar-centro,
        .radar-blip, .radar-tag, .marca-nome { animation: none; }
      }

      /* ── Dropdown RT x SAP ── */
      .nav-dropdown-pai { position: relative; }

      .nav-dropdown-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        cursor: pointer;
        /* mesmos estilos de .nav a */
        font-family: var(--display);
        font-size: var(--t-sm);
        font-weight: 500;
        text-decoration: none;
        color: rgba(255,255,255,.82);
        padding: 0.4rem var(--e-4);
        border-radius: var(--r-md);
        border: 1px solid rgba(255,255,255,.22);
        background: linear-gradient(160deg, rgba(255,255,255,.18) 0%, rgba(255,255,255,.09) 100%);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,.3),
          inset 0 -1px 0 rgba(0,0,0,.18),
          0 2px 12px rgba(0,0,0,.25);
        transition:
          color var(--dur) var(--ease),
          background var(--dur) var(--ease),
          border-color var(--dur) var(--ease),
          box-shadow var(--dur) var(--ease);
        white-space: nowrap;
      }

      .nav-dropdown-btn:hover {
        color: #ffffff;
        background: linear-gradient(160deg, rgba(255,255,255,.26) 0%, rgba(255,255,255,.14) 100%);
        border-color: rgba(255,255,255,.36);
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,.4),
          inset 0 -1px 0 rgba(0,0,0,.15),
          0 4px 20px rgba(0,0,0,.35);
      }

      .nav-dropdown-chevron {
        width: 13px;
        height: 13px;
        transition: transform .2s ease;
        flex-shrink: 0;
      }

      .nav-dropdown-btn[aria-expanded="true"] .nav-dropdown-chevron {
        transform: rotate(180deg);
      }

      .nav-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + .6rem);
        right: 0;
        min-width: 260px;
        list-style: none;
        margin: 0;
        padding: .4rem;
        background: rgba(6,9,26,.92);
        border: 1px solid rgba(59,130,246,.3);
        border-radius: .75rem;
        box-shadow: 0 8px 32px rgba(0,0,0,.5), 0 0 18px rgba(59,130,246,.12);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        z-index: 200;
      }

      .nav-dropdown.aberto { display: block; }

      .nav-dropdown li a {
        display: block;
        padding: .55rem 1rem;
        font-family: var(--display);
        font-size: var(--t-sm);
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        color: var(--azul-200, #bfdbfe);
        border-radius: .5rem;
        border: 1px solid rgba(59,130,246,.28);
        background: linear-gradient(135deg, rgba(59,130,246,.18) 0%, rgba(99,102,241,.10) 100%);
        box-shadow:
          inset 0 1px 0 rgba(147,197,253,.25),
          inset 0 -1px 0 rgba(0,0,0,.12),
          0 0 10px rgba(59,130,246,.12);
        white-space: nowrap;
        transition: color .15s, background .15s, border-color .15s, box-shadow .15s;
        margin-bottom: .25rem;
      }

      .nav-dropdown li:last-child a { margin-bottom: 0; }

      .nav-dropdown li a:hover,
      .nav-dropdown li a:focus {
        color: #ffffff;
        background: linear-gradient(135deg, rgba(59,130,246,.32) 0%, rgba(99,102,241,.22) 100%);
        border-color: rgba(59,130,246,.55);
        box-shadow:
          inset 0 1px 0 rgba(147,197,253,.4),
          inset 0 -1px 0 rgba(0,0,0,.15),
          0 0 18px rgba(59,130,246,.25);
        outline: none;
      }

      .nav-dropdown li a[aria-current="page"] {
        color: #ffffff;
        border-color: rgba(59,130,246,.6);
        background: linear-gradient(135deg, rgba(59,130,246,.38) 0%, rgba(99,102,241,.26) 100%);
      }

      /* ── Mobile: seção RT x SAP ── */
      .menu-mobile-secao {
        padding: .45rem 1.25rem .2rem;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--texto-terciario, #64748b);
        pointer-events: none;
        margin-top: .4rem;
      }

      .menu-mobile-sub {
        padding-left: 2rem !important;
        font-size: .9rem !important;
        color: var(--texto-secundario, #94a3b8) !important;
      }
    </style>

    <script>
      // ── Tema ──
      const html = document.documentElement;
      function aplicarTema(t: string) {
        html.dataset.tema = t;
        const lua = document.getElementById('icone-lua') as HTMLElement;
        const sol = document.getElementById('icone-sol') as HTMLElement;
        if (t === 'escuro') { lua.style.display = 'none'; sol.style.display = ''; }
        else                { lua.style.display = '';     sol.style.display = 'none'; }
        localStorage.setItem('tema', t);
      }
      // Sincroniza ícone com tema já aplicado (script inline no head)
      aplicarTema(html.dataset.tema ?? 'escuro');
      document.getElementById('btn-tema')!.addEventListener('click', () => {
        aplicarTema(html.dataset.tema === 'escuro' ? 'claro' : 'escuro');
      });

      // ── Menu mobile ──
      const btnMenu    = document.getElementById('btn-menu')!;
      const menuMobile = document.getElementById('menu-mobile')!;
      const iMenu      = document.getElementById('icone-menu')!;
      const iFechar    = document.getElementById('icone-fechar')!;

      function fecharMenuMobile() {
        menuMobile.classList.remove('aberto');
        btnMenu.setAttribute('aria-expanded', 'false');
        iMenu.style.display   = '';
        iFechar.style.display = 'none';
      }

      btnMenu.addEventListener('click', () => {
        const aberto = menuMobile.classList.toggle('aberto');
        btnMenu.setAttribute('aria-expanded', String(aberto));
        iMenu.style.display   = aberto ? 'none' : '';
        iFechar.style.display = aberto ? ''     : 'none';
      });

      menuMobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', fecharMenuMobile);
      });

      // ── Dropdown RT x SAP ──
      const dropBtn  = document.querySelector('.nav-dropdown-btn') as HTMLButtonElement | null;
      const dropMenu = document.querySelector('.nav-dropdown')      as HTMLElement | null;

      if (dropBtn && dropMenu) {
        dropBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const aberto = dropMenu.classList.toggle('aberto');
          dropBtn.setAttribute('aria-expanded', String(aberto));
        });

        document.addEventListener('click', () => {
          dropMenu.classList.remove('aberto');
          dropBtn.setAttribute('aria-expanded', 'false');
        });

        dropMenu.querySelectorAll('a').forEach((a) => {
          a.addEventListener('keydown', (e) => {
            if ((e as KeyboardEvent).key === 'Escape') {
              dropMenu.classList.remove('aberto');
              dropBtn.setAttribute('aria-expanded', 'false');
              dropBtn.focus();
            }
          });
        });
      }

      // ── Barra de progresso de leitura ──
      const barraLeitura = document.getElementById('progresso-barra')!;
      function atualizarProgresso() {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        if (total <= 0) return;
        barraLeitura.style.width = (window.scrollY / total * 100) + '%';
      }
      window.addEventListener('scroll', atualizarProgresso, { passive: true });

      // ── Botão voltar ao topo ──
      const btnTopo = document.getElementById('topo')!;
      window.addEventListener('scroll', () => {
        btnTopo.classList.toggle('visivel', window.scrollY > 500);
      }, { passive: true });
      btnTopo.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // ── Modal de busca ──
      const modal        = document.getElementById('modal-busca')!;
      const campoBusca   = document.getElementById('campo-busca') as HTMLInputElement;
      const areaResult   = document.getElementById('modal-resultados')!;

      // ── Busca: Pagefind (índice gerado no build) com fallback no índice dinâmico ──
      const esc = (t: string) =>
        t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      let pagefind: any = null;
      let pagefindFalhou = false;
      async function carregarPagefind() {
        if (pagefind || pagefindFalhou) return pagefind;
        try {
          const caminho = '/pagefind/pagefind.js';
          pagefind = await import(/* @vite-ignore */ caminho);
          await pagefind.options({ baseUrl: '/' });
        } catch {
          pagefindFalhou = true;
        }
        return pagefind;
      }

      type ItemBusca = { titulo: string; url: string; desc: string; tags: string };
      let indiceLocal: ItemBusca[] | null = null;
      async function carregarIndiceLocal() {
        if (indiceLocal !== null) return indiceLocal;
        try {
          const r = await fetch('/search-index.json');
          if (r.ok) indiceLocal = await r.json();
        } catch { /* sem fallback adicional */ }
        return indiceLocal ?? [];
      }

      function buscaFixa(query: string, indice: ItemBusca[]) {
        return indice.filter((p) =>
          p.titulo.toLowerCase().includes(query) ||
          p.desc.toLowerCase().includes(query) ||
          (p.tags && p.tags.toLowerCase().includes(query))
        ).slice(0, 10).map((p) => ({ url: p.url, titulo: esc(p.titulo), trecho: esc(p.desc) }));
      }

      async function buscaIndice(query: string) {
        const pf = await carregarPagefind();
        if (!pf) return null;
        const busca = await pf.search(query);
        const dados = await Promise.all(busca.results.slice(0, 8).map((r: any) => r.data()));
        return dados.map((d: any) => ({
          url: d.url.replace(/\.html$/, '').replace(/\/index$/, '/'),
          titulo: esc(d.meta?.title ?? d.url),
          trecho: d.excerpt as string, // Pagefind já escapa o HTML e marca o termo com <mark>
        }));
      }

      let buscaAtual = 0;
      async function renderResultados(q: string) {
        const consulta = ++buscaAtual;
        const query = q.trim().toLowerCase();
        if (!query) {
          areaResult.innerHTML = '<p class="modal-vazio">Digite para buscar…</p>';
          return;
        }
        const itens = (await buscaIndice(query)) ?? buscaFixa(query, await carregarIndiceLocal());
        if (consulta !== buscaAtual) return; // resposta antiga: descarta
        if (!itens.length) {
          areaResult.innerHTML = '<p class="modal-vazio">Nenhum resultado para "' + esc(q) + '"</p>';
          return;
        }
        areaResult.innerHTML = itens.map((p) =>
          `<a class="resultado-item" href="${p.url}"><strong>${p.titulo}</strong><small>${p.trecho}</small></a>`
        ).join('');
      }

      function abrirBusca() {
        modal.classList.add('ativo');
        carregarPagefind();
        carregarIndiceLocal();
        campoBusca.focus();
        campoBusca.value = '';
        renderResultados('');
      }
      function fecharBusca() { modal.classList.remove('ativo'); }

      document.getElementById('btn-abrir-busca')!.addEventListener('click', abrirBusca);
      document.getElementById('btn-abrir-busca-mobile')?.addEventListener('click', abrirBusca);
      document.getElementById('btn-busca-nav-inf')?.addEventListener('click', abrirBusca);
      modal.addEventListener('click', (e) => { if (e.target === modal) fecharBusca(); });
      campoBusca.addEventListener('input', () => renderResultados(campoBusca.value));

      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); abrirBusca(); }
        if (e.key === 'Escape') {
          if (modal.classList.contains('ativo')) fecharBusca();
          else if (menuMobile.classList.contains('aberto')) fecharMenuMobile();
        }
      });

      // Navegação por teclado nos resultados
      areaResult.addEventListener('keydown', (e) => {
        const itens = Array.from(areaResult.querySelectorAll('.resultado-item')) as HTMLElement[];
        const idx   = itens.indexOf(document.activeElement as HTMLElement);
        if (e.key === 'ArrowDown') { e.preventDefault(); itens[Math.min(idx + 1, itens.length - 1)]?.focus(); }
        if (e.key === 'ArrowUp')   { e.preventDefault(); if (idx <= 0) campoBusca.focus(); else itens[idx - 1]?.focus(); }
      });
      campoBusca.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          const primeiro = areaResult.querySelector('.resultado-item') as HTMLElement | null;
          if (primeiro) { e.preventDefault(); primeiro.focus(); }
        }
      });
    </script>
  </body>
</html>
