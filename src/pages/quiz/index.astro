        alts:[
          { t:`Não, pode optar em março/2027, com efeito a partir do segundo semestre de 2027`, c:true },
          { t:`Sim, só em setembro/2027`, c:false },
          { t:`Sim, definitivamente`, c:false },
          { t:`Pode optar a qualquer mês de 2027`, c:false },
        ],
        exp:`A partir de 2027 a opção ou renúncia ocorre em março e setembro. Quem opta em março passa ao regime regular no segundo semestre.`,
        prat:`Deixe março/2027 marcado como janela de revisão para clientes que perderam setembro.`,
        base:`Agência Gov / Serpro` },

      { id:'SN-03', tipo:'direto', tema:'sn', temaNome:'Simples Nacional', nivel:'intermediario',
        contexto:`Uma indústria do regime regular compra de dois fornecedores do Simples: um ficou no DAS e outro optou pelo regime regular de IBS/CBS. Como fica o crédito?`,
        afirmacao:null,
        alts:[
          { t:`Do fornecedor no DAS, crédito limitado ao IBS/CBS devidos no Simples; do outro, o valor destacado, condicionado à extinção do débito`, c:true },
          { t:`Crédito igual nos dois casos`, c:false },
          { t:`Nenhum crédito em compras do Simples`, c:false },
          { t:`Crédito cheio nos dois casos`, c:false },
        ],
        exp:`Pelo art. 47, § 9º da LC 214, o crédito de compra do Simples no DAS é limitado ao devido no regime. No regime regular, vale o destaque.`,
        prat:`Revise a matriz de fornecedores: o regime de IBS/CBS do fornecedor passa a afetar o custo líquido da compra.`,
        base:`LC 214/2025, art. 47` },

      { id:'SN-04', tipo:'direto', tema:'sn', temaNome:'Simples Nacional', nivel:'intermediario',
        contexto:`Uma empresa que manteve IBS e CBS dentro do DAS pode se creditar dos tributos destacados nas suas compras?`,
