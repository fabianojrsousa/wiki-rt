---
import Base from '../../layouts/Base.astro';
---

<Base
  titulo="Novas Obrigações 2027"
  descricao="O que acaba, o que fica e o que é criado nas obrigações acessórias da Reforma Tributária — de 2027 até a extinção do ICMS e ISS em 2033."
>
<style>
  /* ── Contentor geral ─────────────────────────────── */
  .no-wrap { display:flex; flex-direction:column; gap:var(--e-6,2.5rem); }

  /* ══════════════════════════════════════════════════
     1. STATS — três números grandes
  ══════════════════════════════════════════════════ */
  .no-stats {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: var(--e-4);
  }
  @media(max-width:640px){ .no-stats{ grid-template-columns:1fr; gap:var(--e-3); } }

  .no-stat {
    background: rgba(8,15,42,.7);
    border: 1px solid var(--borda-forte);
    border-radius: 18px;
    padding: var(--e-5) var(--e-5) var(--e-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .no-stat::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: .06;
    pointer-events: none;
  }
  .no-stat.s-encerra::after { background: #f87171; }
  .no-stat.s-novo::after    { background: #4ade80; }
  .no-stat.s-cont::after    { background: #fbbf24; }

  .no-stat-acento {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 18px 18px 0 0;
  }
  .no-stat.s-encerra .no-stat-acento { background:linear-gradient(90deg,#f87171,rgba(248,113,113,.2)); }
  .no-stat.s-novo    .no-stat-acento { background:linear-gradient(90deg,#4ade80,rgba(34,211,238,.3)); }
  .no-stat.s-cont    .no-stat-acento { background:linear-gradient(90deg,#fbbf24,rgba(251,146,60,.3)); }

  .no-stat-num {
    font-family: var(--dado);
    font-size: clamp(2.6rem,5vw,3.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -.04em;
    padding-top: var(--e-3);
  }
  .no-stat.s-encerra .no-stat-num { color:#f87171; }
  .no-stat.s-novo    .no-stat-num { color:#4ade80; }
  .no-stat.s-cont    .no-stat-num { color:#fbbf24; }

  .no-stat-titulo {
    font-size: .92rem;
    font-weight: 700;
    color: var(--tinta);
    text-transform: uppercase;
    letter-spacing: .07em;
  }
  .no-stat-sub {
    font-family: var(--dado);
    font-size: .72rem;
    color: var(--tinta-fraca);
    margin-top: 2px;
  }
  .no-stat-lista {
    list-style: none;
    margin: var(--e-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
    text-align: left;
  }
  .no-stat-lista li {
    font-size: .78rem;
    color: var(--tinta-media);
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 4px 0;
    border-top: 1px solid var(--borda);
  }
  .no-stat-lista li::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .no-stat.s-encerra .no-stat-lista li::before { background:#f87171; }
  .no-stat.s-novo    .no-stat-lista li::before { background:#4ade80; }
  .no-stat.s-cont    .no-stat-lista li::before { background:#fbbf24; }

  /* ══════════════════════════════════════════════════
     2. VIRADA — antes vs. depois
  ══════════════════════════════════════════════════ */
  .no-virada {
    background: rgba(8,15,42,.7);
    border: 1px solid var(--borda-forte);
    border-radius: 18px;
    overflow: hidden;
  }
  .no-virada-topo {
    height: 3px;
    background: linear-gradient(90deg,var(--azul-400) 0%,rgba(34,211,238,.4) 100%);
  }
  .no-virada-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media(max-width:640px){ .no-virada-grid{ grid-template-columns:1fr; } }

  .no-lado {
    padding: var(--e-6) var(--e-5);
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
  }
  .no-lado + .no-lado {
    border-left: 1px solid var(--borda);
  }
  @media(max-width:640px){ .no-lado + .no-lado{ border-left:none; border-top:1px solid var(--borda); } }

  .no-lado-label {
    font-family: var(--dado);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    display: inline-flex;
    align-self: flex-start;
  }
  .no-lado-label.antes {
    background: rgba(248,113,113,.12);
    border: 1px solid rgba(248,113,113,.25);
    color: #fca5a5;
  }
  .no-lado-label.depois {
    background: rgba(34,211,238,.1);
    border: 1px solid rgba(34,211,238,.25);
    color: #67e8f9;
  }

  .no-lado-titulo {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -.02em;
  }
  .no-lado.antes-lado .no-lado-titulo { color: #fca5a5; }
  .no-lado.depois-lado .no-lado-titulo { color: #67e8f9; }

  .no-lado-desc {
    font-size: .875rem;
    color: var(--tinta-media);
    line-height: 1.65;
  }
  .no-lado-desc strong { color: var(--tinta); }

  .no-passos {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    margin-top: var(--e-2);
  }
  .no-passo {
    display: flex;
    align-items: flex-start;
    gap: var(--e-3);
  }
  .no-passo-num {
    font-family: var(--dado);
    font-size: .7rem;
    font-weight: 900;
    width: 22px; height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .depois-lado .no-passo-num {
    background: rgba(34,211,238,.15);
    border: 1px solid rgba(34,211,238,.3);
    color: #67e8f9;
  }
  .antes-lado .no-passo-num {
    background: rgba(248,113,113,.12);
    border: 1px solid rgba(248,113,113,.25);
    color: #fca5a5;
  }
  .no-passo-txt {
    font-size: .85rem;
    color: var(--tinta-media);
    line-height: 1.55;
  }
  .no-passo-txt strong { color: var(--tinta); }

  /* Alerta silêncio — faixa vermelha */
  .no-alerta-silencio {
    margin: 0;
    padding: var(--e-4) var(--e-5);
    background: rgba(248,113,113,.1);
    border-top: 1px solid rgba(248,113,113,.25);
    display: flex;
    align-items: flex-start;
    gap: var(--e-4);
  }
  .no-alerta-icone {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: rgba(248,113,113,.18);
    border: 1px solid rgba(248,113,113,.35);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .no-alerta-icone svg { width: 18px; height: 18px; color: #f87171; }
  .no-alerta-txt { flex: 1; min-width: 0; }
  .no-alerta-txt strong {
    display: block;
    font-size: .92rem;
    font-weight: 800;
    color: #fca5a5;
    margin-bottom: 3px;
  }
  .no-alerta-txt p {
    margin: 0;
    font-size: .82rem;
    color: var(--tinta-media);
    line-height: 1.6;
  }
  .no-alerta-txt p em { color: var(--tinta); font-style: normal; font-weight: 600; }

  /* ══════════════════════════════════════════════════
     3. PAINEL DE OBRIGAÇÕES — 3 colunas
  ══════════════════════════════════════════════════ */
  .no-painel {
    background: rgba(8,15,42,.7);
    border: 1px solid var(--borda-forte);
    border-radius: 18px;
    overflow: hidden;
  }
  .no-painel-hdr {
    padding: var(--e-4) var(--e-5);
    border-bottom: 1px solid var(--borda);
    background: rgba(255,255,255,.02);
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }
  .no-painel-hdr-titulo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--tinta);
  }
  .no-painel-hdr-sub {
    font-size: .78rem;
    color: var(--tinta-fraca);
  }

  .no-cols {
    display: grid;
    grid-template-columns: repeat(3,1fr);
  }
  @media(max-width:860px){ .no-cols{ grid-template-columns:1fr; } }

  .no-col {
    display: flex;
    flex-direction: column;
  }
  .no-col + .no-col {
    border-left: 1px solid var(--borda);
  }
  @media(max-width:860px){ .no-col + .no-col{ border-left:none; border-top:1px solid var(--borda); } }

  .no-col-hdr {
    padding: var(--e-4) var(--e-4) var(--e-3);
    display: flex;
    align-items: center;
    gap: var(--e-3);
    position: sticky;
    top: 0;
  }
  .no-col.encerra .no-col-hdr { background:rgba(248,113,113,.08); border-bottom:2px solid rgba(248,113,113,.25); }
  .no-col.novo    .no-col-hdr { background:rgba(74,222,128,.07);  border-bottom:2px solid rgba(74,222,128,.22); }
  .no-col.cont    .no-col-hdr { background:rgba(251,191,36,.07);  border-bottom:2px solid rgba(251,191,36,.22); }

  .no-col-icone {
    width: 32px; height: 32px;
    border-radius: 9px;
    display: flex; align-items:center; justify-content:center;
    flex-shrink: 0;
  }
  .no-col.encerra .no-col-icone { background:rgba(248,113,113,.18); border:1px solid rgba(248,113,113,.3); }
  .no-col.novo    .no-col-icone { background:rgba(74,222,128,.16);  border:1px solid rgba(74,222,128,.28); }
  .no-col.cont    .no-col-icone { background:rgba(251,191,36,.14);  border:1px solid rgba(251,191,36,.26); }
  .no-col.encerra .no-col-icone svg { color:#f87171; width:15px; height:15px; }
  .no-col.novo    .no-col-icone svg { color:#4ade80; width:15px; height:15px; }
  .no-col.cont    .no-col-icone svg { color:#fbbf24; width:15px; height:15px; }

  .no-col-hdr-txt {}
  .no-col-hdr-titulo {
    font-size: .82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .no-col.encerra .no-col-hdr-titulo { color:#f87171; }
  .no-col.novo    .no-col-hdr-titulo { color:#4ade80; }
  .no-col.cont    .no-col-hdr-titulo { color:#fbbf24; }
  .no-col-hdr-count {
    font-family: var(--dado);
    font-size: .7rem;
    color: var(--tinta-fraca);
  }

  .no-col-items {
    display: flex;
    flex-direction: column;
    padding: var(--e-3) var(--e-3);
    gap: var(--e-2);
    flex: 1;
  }

  .no-item {
    border-radius: 12px;
    padding: var(--e-3) var(--e-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid transparent;
    transition: border-color .15s;
  }
  .no-col.encerra .no-item { background:rgba(248,113,113,.05); }
  .no-col.novo    .no-item { background:rgba(74,222,128,.04);  }
  .no-col.cont    .no-item { background:rgba(251,191,36,.04);  }
  .no-col.encerra .no-item:hover { border-color:rgba(248,113,113,.2); }
  .no-col.novo    .no-item:hover { border-color:rgba(74,222,128,.18);  }
  .no-col.cont    .no-item:hover { border-color:rgba(251,191,36,.18);  }

  .no-item-titulo {
    font-size: .875rem;
    font-weight: 700;
    color: var(--tinta);
    word-break: break-word;
    min-width: 0;
  }
  .no-item-badge {
    font-family: var(--dado);
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    display: inline-flex;
    align-self: flex-start;
  }
  .no-col.encerra .no-item-badge { background:rgba(248,113,113,.14); border:1px solid rgba(248,113,113,.28); color:#fca5a5; }
  .no-col.novo    .no-item-badge { background:rgba(74,222,128,.12);  border:1px solid rgba(74,222,128,.25);  color:#86efac; }
  .no-col.cont    .no-item-badge { background:rgba(251,191,36,.12);  border:1px solid rgba(251,191,36,.25);  color:#fde68a; }
  .no-item-badge.destaque-badge  { background:rgba(156,163,175,.1);  border:1px solid rgba(156,163,175,.2);  color:#9ca3af; }
  .no-item-badge.adiado-badge    { background:rgba(251,191,36,.11);  border:1px solid rgba(251,191,36,.24);  color:#fde68a; }

  .no-item-desc {
    font-size: .79rem;
    color: var(--tinta-fraca);
    line-height: 1.55;
  }
  .no-item-desc strong { color: var(--tinta-media); }

  /* nota de rodapé dentro do painel */
  .no-painel-nota {
    padding: var(--e-3) var(--e-5);
    border-top: 1px solid var(--borda);
    background: rgba(251,191,36,.04);
    display: flex;
    gap: var(--e-3);
    align-items: flex-start;
  }
  .no-painel-nota svg { width:15px; height:15px; color:#fbbf24; flex-shrink:0; margin-top:2px; }
  .no-painel-nota p { margin:0; font-size:.78rem; color:var(--tinta-fraca); line-height:1.55; }
  .no-painel-nota p strong { color:var(--tinta-media); }

  /* ══════════════════════════════════════════════════
     4. TIMELINE VISUAL
  ══════════════════════════════════════════════════ */
  .no-tl-card {
    background: rgba(8,15,42,.7);
    border: 1px solid var(--borda-forte);
    border-radius: 18px;
    overflow: hidden;
  }
  .no-tl-hdr {
    padding: var(--e-4) var(--e-5);
    border-bottom: 1px solid var(--borda);
    background: rgba(34,211,238,.06);
    display: flex;
    align-items: center;
    gap: var(--e-3);
  }
  .no-tl-hdr-icone {
    width: 32px; height: 32px;
    border-radius: 9px;
    background: rgba(34,211,238,.14);
    border: 1px solid rgba(34,211,238,.28);
    display: flex; align-items:center; justify-content:center;
    flex-shrink: 0;
  }
  .no-tl-hdr-icone svg { width:15px; height:15px; color:#22d3ee; }
  .no-tl-hdr-titulo { font-size:1rem; font-weight:700; color:var(--tinta); }
  .no-tl-hdr-sub { font-size:.78rem; color:var(--tinta-fraca); }

  .no-tl-body {
    padding: var(--e-5) var(--e-5) var(--e-4);
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }
  /* linha central vertical */
  .no-tl-body::before {
    content:'';
    position:absolute;
    left: calc(var(--e-5) + 42px);
    top: var(--e-5);
    bottom: var(--e-4);
    width: 2px;
    background: linear-gradient(180deg,
      rgba(34,211,238,.4) 0%,
      rgba(34,211,238,.15) 50%,
      rgba(34,211,238,.06) 100%
    );
    border-radius: 2px;
  }
  @media(max-width:540px){
    .no-tl-body::before{ left: calc(var(--e-4) + 30px); }
  }

  .no-tl-evento {
    display: flex;
    align-items: flex-start;
    gap: var(--e-4);
    padding: var(--e-3) 0;
    position: relative;
  }

  .no-tl-data-col {
    width: 86px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 3px;
  }
  @media(max-width:540px){ .no-tl-data-col{ width:60px; } }

  .no-tl-data {
    font-family: var(--dado);
    font-size: .72rem;
    font-weight: 700;
    color: var(--tinta-fraca);
    text-align: right;
    line-height: 1.3;
  }
  .no-tl-evento.marco .no-tl-data { color: #22d3ee; }

  /* dot na linha */
  .no-tl-dot-col {
    width: 16px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    padding-top: 5px;
    position: relative;
    z-index: 1;
  }
  .no-tl-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--borda-forte);
    border: 2px solid rgba(34,211,238,.25);
    flex-shrink: 0;
  }
  .no-tl-evento.marco .no-tl-dot {
    width: 16px; height: 16px;
    background: rgba(34,211,238,.25);
    border: 2px solid #22d3ee;
    box-shadow: 0 0 10px rgba(34,211,238,.35);
  }
  .no-tl-evento.alerta .no-tl-dot {
    background: rgba(248,113,113,.2);
    border-color: #f87171;
  }
  .no-tl-evento.positivo .no-tl-dot {
    background: rgba(74,222,128,.18);
    border-color: #4ade80;
  }
  .no-tl-evento.neutro .no-tl-dot {
    background: rgba(251,191,36,.14);
    border-color: #fbbf24;
  }

  /* conteúdo do evento */
  .no-tl-content { flex: 1; min-width: 0; padding-bottom: var(--e-4); }

  .no-tl-evento-titulo {
    font-size: .88rem;
    font-weight: 700;
    color: var(--tinta);
    line-height: 1.4;
    word-break: break-word;
  }
  .no-tl-evento.marco .no-tl-evento-titulo {
    font-size: 1rem;
    color: #67e8f9;
  }
  .no-tl-evento-desc {
    font-size: .8rem;
    color: var(--tinta-fraca);
    line-height: 1.6;
    margin-top: 4px;
    word-break: break-word;
  }
  .no-tl-evento-desc strong { color: var(--tinta-media); }

  /* tags inline na timeline */
  .no-tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 7px;
  }
  .no-tl-tag {
    font-family: var(--dado);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .no-tl-tag.vermelho { background:rgba(248,113,113,.13); border:1px solid rgba(248,113,113,.25); color:#fca5a5; }
  .no-tl-tag.verde    { background:rgba(74,222,128,.11);  border:1px solid rgba(74,222,128,.22);  color:#86efac; }
  .no-tl-tag.amarelo  { background:rgba(251,191,36,.1);   border:1px solid rgba(251,191,36,.22);  color:#fde68a; }
  .no-tl-tag.cinza    { background:rgba(156,163,175,.09); border:1px solid rgba(156,163,175,.18); color:#9ca3af; }
  .no-tl-tag.ciano    { background:rgba(34,211,238,.1);   border:1px solid rgba(34,211,238,.22);  color:#67e8f9; }

  /* separador de ano */
  .no-tl-ano {
    font-family: var(--dado);
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--tinta-fraca);
    padding: var(--e-2) 0 var(--e-1);
    display: flex;
    align-items: center;
    gap: var(--e-3);
    opacity: .5;
  }
  .no-tl-ano::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--borda);
  }
</style>

<!-- Cabeçalho da página -->
<div class="pagina-header">
  <div class="pagina-badge">Obrigações · Reforma Tributária</div>
  <h1 class="pagina-h1">
    Novas <span class="hero-destaque">Obrigações</span>
  </h1>
  <p class="pagina-subtitulo">
    O que acaba, o que fica e o que é criado nas obrigações acessórias a partir de 2027 — até a extinção do ICMS e ISS em 2033.
  </p>
</div>

<div class="no-wrap">

  <!-- ══ 1. STATS ══════════════════════════════════════════ -->
  <div class="no-stats">

    <div class="no-stat s-encerra">
      <div class="no-stat-acento"></div>
      <span class="no-stat-num">3</span>
      <span class="no-stat-titulo">Encerram</span>
      <span class="no-stat-sub">em jan/2027</span>
      <ul class="no-stat-lista">
        <li>EFD-Contribuições (novas competências)</li>
        <li>PIS e Cofins</li>
        <li>DCTF (já foi em 2025)</li>
      </ul>
    </div>

    <div class="no-stat s-novo">
      <div class="no-stat-acento"></div>
      <span class="no-stat-num">5</span>
      <span class="no-stat-titulo">Novidades</span>
      <span class="no-stat-sub">novos mecanismos</span>
      <ul class="no-stat-lista">
        <li>Campos IBS/CBS nos XMLs</li>
        <li>Apuração assistida</li>
        <li>DeRE</li>
        <li>RAD</li>
        <li>Split payment</li>
      </ul>
    </div>

