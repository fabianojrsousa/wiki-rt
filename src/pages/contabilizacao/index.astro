---
import Base from '../../layouts/Base.astro';
---

<Base
  titulo="Contabilização IBS e CBS"
  descricao="Resumo prático e simplificado dos lançamentos contábeis de IBS e CBS — venda, compra, apuração e mapa mental."
>
  <style>
    /* ══════════════════════════════════════════
       Layout geral
    ══════════════════════════════════════════ */
    .cb-wrap {
      display: flex;
      flex-direction: column;
      gap: var(--e-5);
    }

    .cb-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--e-5);
    }
    @media (max-width: 780px) { .cb-grid-2 { grid-template-columns: 1fr; } }

    /* ══════════════════════════════════════════
       Card base
    ══════════════════════════════════════════ */
    .cb-card {
      background: rgba(8,15,42,.6);
      border: 1px solid var(--borda-forte);
      border-radius: 16px;
      overflow: hidden;
      backdrop-filter: blur(20px) saturate(150%);
      display: flex;
      flex-direction: column;
    }

    /* Barra topo com gradiente */
    .cb-card-top {
      height: 3px;
      background: linear-gradient(90deg, var(--azul-400) 0%, rgba(34,211,238,.5) 100%);
    }

    /* Cabeçalho do card */
    .cb-hdr {
      display: flex;
      align-items: center;
      gap: var(--e-3);
      padding: var(--e-4) var(--e-5) var(--e-3);
      border-bottom: 1px solid var(--borda);
      background: rgba(59,130,246,.13);
    }
    .cb-num {
      font-family: var(--dado);
      font-size: var(--t-xs);
      font-weight: 900;
      color: var(--azul-400);
      background: rgba(59,130,246,.15);
      border: 1px solid rgba(59,130,246,.3);
      border-radius: 999px;
      padding: 1px 8px;
      letter-spacing: .06em;
      flex-shrink: 0;
    }
    .cb-titulo {
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--tinta);
      letter-spacing: -.01em;
    }

    .cb-body {
      padding: var(--e-5);
      display: flex;
      flex-direction: column;
      gap: var(--e-4);
      flex: 1;
    }

    /* ══════════════════════════════════════════
       Lançamentos contábeis
    ══════════════════════════════════════════ */
    .cb-grupo {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* Grupo com borda tracejada (como no print) */
    .cb-grupo-box {
      border: 1.5px dashed rgba(59,130,246,.3);
      border-radius: 10px;
      padding: var(--e-4);
      background: rgba(59,130,246,.04);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .cb-linha {
      display: flex;
      align-items: center;
      gap: var(--e-3);
      line-height: 1.45;
    }

    /* Badge D / C */
    .cb-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 6px;
      font-family: var(--dado);
      font-size: .8rem;
      font-weight: 900;
      flex-shrink: 0;
    }
    .cb-badge.d {
      background: rgba(248,113,113,.18);
      border: 1px solid rgba(248,113,113,.35);
      color: #fca5a5;
    }
    .cb-badge.c {
      background: rgba(74,222,128,.14);
      border: 1px solid rgba(74,222,128,.3);
      color: #86efac;
    }

    .cb-conta {
      font-family: var(--display);
      font-size: .875rem;
      color: var(--tinta);
      font-weight: 500;
    }
    .cb-conta-sub {
      font-size: .75rem;
      color: var(--tinta-fraca);
      font-style: italic;
      font-family: var(--display);
    }

    /* ══════════════════════════════════════════
       Caixas de observação / nota
    ══════════════════════════════════════════ */
    .cb-obs {
      display: flex;
      gap: var(--e-3);
      align-items: flex-start;
      background: rgba(59,130,246,.08);
      border: 1px solid rgba(59,130,246,.2);
      border-left: 3px solid var(--azul-400);
      border-radius: 10px;
      padding: var(--e-3) var(--e-4);
    }
    .cb-obs-icone {
      width: 18px; height: 18px;
      flex-shrink: 0;
      margin-top: 1px;
      color: var(--azul-400);
    }
    .cb-obs p {
      margin: 0;
      font-size: .85rem;
      color: var(--tinta-media);
      line-height: 1.6;
    }
    .cb-obs strong { color: var(--tinta); }

    .cb-nota {
      display: flex;
      gap: var(--e-3);
      align-items: flex-start;
      background: rgba(251,191,36,.07);
      border: 1px solid rgba(251,191,36,.22);
      border-left: 3px solid #fbbf24;
      border-radius: 10px;
      padding: var(--e-3) var(--e-4);
    }
    .cb-nota-icone {
      width: 18px; height: 18px;
      flex-shrink: 0;
      margin-top: 1px;
      color: #fbbf24;
    }
    .cb-nota p {
      margin: 0;
      font-size: .85rem;
      color: var(--tinta-media);
      line-height: 1.6;
    }
    .cb-nota strong { color: #fde68a; }

    .cb-alerta {
      display: flex;
      gap: var(--e-3);
      align-items: flex-start;
      background: rgba(74,222,128,.06);
      border: 1px solid rgba(74,222,128,.2);
      border-left: 3px solid #4ade80;
      border-radius: 10px;
      padding: var(--e-3) var(--e-4);
    }
    .cb-alerta-icone {
      width: 18px; height: 18px;
      flex-shrink: 0;
      margin-top: 1px;
      color: #4ade80;
    }
    .cb-alerta p {
      margin: 0;
      font-size: .85rem;
      color: var(--tinta-media);
      line-height: 1.6;
    }

    /* ══════════════════════════════════════════
       Card 4 — Atenções
    ══════════════════════════════════════════ */
    .cb-itens {
      display: flex;
      flex-direction: column;
      gap: var(--e-3);
      list-style: none;
      margin: 0; padding: 0;
    }
    .cb-itens li {
      display: flex;
      gap: var(--e-3);
      align-items: flex-start;
      font-size: .875rem;
      color: var(--tinta-media);
      line-height: 1.55;
    }
    .cb-itens-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--azul-400);
      flex-shrink: 0;
      margin-top: .45em;
    }
    .cb-itens li strong { color: var(--tinta); font-weight: 600; }

    /* Ícone de alerta */
    .cb-icon-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px; height: 38px;
      border-radius: 10px;
      background: rgba(251,191,36,.1);
      border: 1px solid rgba(251,191,36,.25);
      flex-shrink: 0;
      margin-bottom: var(--e-3);
    }
    .cb-icon-wrap svg { width: 20px; height: 20px; color: #fbbf24; }

    /* ══════════════════════════════════════════
       Card 5 — Mapa mental
    ══════════════════════════════════════════ */
    .cb-mapa {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .cb-mapa-row {
      display: flex;
      align-items: center;
      gap: var(--e-3);
      flex-wrap: wrap;
      padding: var(--e-4) 0;
    }
    .cb-mapa-row + .cb-mapa-row {
      border-top: 1px dashed var(--borda);
    }

    .cb-tag {
      font-family: var(--dado);
      font-size: .8rem;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 8px;
      flex-shrink: 0;
      min-width: 5.5rem;
      text-align: center;
    }
    .cb-tag.venda    { background: rgba(248,113,113,.15); border: 1px solid rgba(248,113,113,.3); color: #fca5a5; }
    .cb-tag.compra   { background: rgba(74,222,128,.13);  border: 1px solid rgba(74,222,128,.28); color: #86efac; }
    .cb-tag.apuracao { background: rgba(251,191,36,.11);  border: 1px solid rgba(251,191,36,.26); color: #fde68a; }

    .cb-seta {
      color: var(--tinta-fraca);
      font-size: 1.1rem;
      flex-shrink: 0;
      line-height: 1;
    }

    .cb-etapa {
      font-size: .85rem;
      color: var(--tinta-media);
      line-height: 1.4;
    }

    .cb-resultado {
      font-family: var(--dado);
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 6px;
      flex-shrink: 0;
    }
    .cb-resultado.passivo { background: rgba(248,113,113,.12); border: 1px solid rgba(248,113,113,.25); color: #fca5a5; }
    .cb-resultado.ativo   { background: rgba(74,222,128,.12);  border: 1px solid rgba(74,222,128,.22);  color: #86efac; }
    .cb-resultado.saldo   { background: rgba(251,191,36,.11);  border: 1px solid rgba(251,191,36,.24);  color: #fde68a; }

    /* Legend D/C */
    .cb-legenda {
      display: flex;
      gap: var(--e-4);
      align-items: center;
      flex-wrap: wrap;
      padding: var(--e-3) var(--e-5);
      border-top: 1px solid var(--borda);
      background: rgba(0,0,0,.15);
    }
    .cb-legenda-item {
      display: flex;
      align-items: center;
      gap: var(--e-2);
      font-family: var(--dado);
      font-size: var(--t-xs);
      color: var(--tinta-fraca);
    }
  </style>

  <!-- Cabeçalho -->
  <div class="pagina-header">
    <div class="pagina-badge">Contabilidade · IBS e CBS</div>
    <h1 class="pagina-h1">
      Contabilização <span class="hero-destaque">IBS e CBS</span>
    </h1>
    <p class="pagina-subtitulo">
      Resumo prático e simplificado — lançamentos de venda, compra com crédito, apuração e mapa mental dos novos tributos.
    </p>
  </div>

  <div class="cb-wrap">

    <!-- ── Grade superior 2 colunas ── -->
    <div class="cb-grid-2">

      <!-- ═══ 1. Venda ═══ -->
      <div class="cb-card">
        <div class="cb-card-top"></div>
        <div class="cb-hdr">
          <span class="cb-num">1</span>
          <span class="cb-titulo" style="color:var(--azul-400)">Venda</span>
        </div>
        <div class="cb-body">
          <p style="font-size:.75rem;font-family:var(--display);letter-spacing:.06em;text-transform:uppercase;color:var(--tinta-fraca);margin:0">
            Exemplo didático simplificado
          </p>

          <!-- Grupo 1 — reconhecimento da receita -->
          <div class="cb-grupo">
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">Clientes / Caixa <span class="cb-conta-sub">— valor total da operação</span></span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">Receita Bruta de Vendas</span>
            </div>
          </div>

          <!-- Grupo 2 — tributos (caixa tracejada como no print) -->
          <div class="cb-grupo-box">
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">Deduções da Receita – IBS</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">Deduções da Receita – CBS</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">IBS a Recolher</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">CBS a Recolher</span>
            </div>
          </div>

          <!-- Observação -->
          <div class="cb-obs">
            <svg class="cb-obs-icone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
            </svg>
            <p>Os tributos da venda <strong>reduzem a receita líquida</strong> e geram obrigação a recolher.</p>
          </div>
        </div>

        <!-- Legenda D/C -->
        <div class="cb-legenda">
          <span class="cb-legenda-item"><span class="cb-badge d" style="width:18px;height:18px;font-size:.65rem">D</span>Débito</span>
          <span class="cb-legenda-item"><span class="cb-badge c" style="width:18px;height:18px;font-size:.65rem">C</span>Crédito</span>
        </div>
      </div>

      <!-- ═══ 2. Compra com direito a crédito ═══ -->
      <div class="cb-card">
        <div class="cb-card-top" style="background:linear-gradient(90deg,#4ade80 0%,rgba(34,211,238,.4) 100%)"></div>
        <div class="cb-hdr" style="background:rgba(74,222,128,.13)">
          <span class="cb-num" style="color:#4ade80;background:rgba(74,222,128,.2);border-color:rgba(74,222,128,.35)">2</span>
          <span class="cb-titulo" style="color:#4ade80">Compra com direito a crédito</span>
        </div>
        <div class="cb-body">
          <div class="cb-grupo">
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">Estoques / Insumos / Despesa</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">IBS a Recuperar</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">CBS a Recuperar</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">Fornecedores / Caixa</span>
            </div>
          </div>

          <div class="cb-alerta">
            <svg class="cb-alerta-icone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <p>Quando houver direito ao crédito, o imposto <strong>não vira custo</strong>; vira <strong>ativo a recuperar</strong>.</p>
          </div>
        </div>
        <div class="cb-legenda">
          <span class="cb-legenda-item"><span class="cb-badge d" style="width:18px;height:18px;font-size:.65rem">D</span>Débito</span>
          <span class="cb-legenda-item"><span class="cb-badge c" style="width:18px;height:18px;font-size:.65rem">C</span>Crédito</span>
        </div>
      </div>

      <!-- ═══ 3. Apuração / Compensação ═══ -->
      <div class="cb-card">
        <div class="cb-card-top" style="background:linear-gradient(90deg,#a78bfa 0%,rgba(59,130,246,.4) 100%)"></div>
        <div class="cb-hdr" style="background:rgba(167,139,250,.13)">
          <span class="cb-num" style="color:#a78bfa;background:rgba(167,139,250,.2);border-color:rgba(167,139,250,.35)">3</span>
          <span class="cb-titulo" style="color:#a78bfa">Apuração / Compensação</span>
        </div>
        <div class="cb-body">
          <!-- IBS -->
          <div class="cb-grupo-box" style="border-color:rgba(167,139,250,.3);background:rgba(167,139,250,.04)">
            <p style="font-size:.72rem;font-family:var(--display);letter-spacing:.06em;text-transform:uppercase;color:#a78bfa;margin:0">IBS</p>
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">IBS a Recolher</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">IBS a Recuperar</span>
            </div>
          </div>

          <!-- CBS -->
          <div class="cb-grupo-box" style="border-color:rgba(251,191,36,.3);background:rgba(251,191,36,.04)">
            <p style="font-size:.72rem;font-family:var(--display);letter-spacing:.06em;text-transform:uppercase;color:#fbbf24;margin:0">CBS</p>
            <div class="cb-linha">
              <span class="cb-badge d">D</span>
              <span class="cb-conta">CBS a Recolher</span>
            </div>
            <div class="cb-linha">
              <span class="cb-badge c">C</span>
              <span class="cb-conta">CBS a Recuperar</span>
            </div>
          </div>

          <div class="cb-nota">
            <svg class="cb-nota-icone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
            </svg>
            <p>Saldo final = <strong>valor a recolher</strong> ou <strong>saldo credor a compensar</strong>.</p>
          </div>
        </div>
      </div>

      <!-- ═══ 4. Atenções ═══ -->
      <div class="cb-card">
        <div class="cb-card-top" style="background:linear-gradient(90deg,#fb923c 0%,rgba(251,191,36,.4) 100%)"></div>
        <div class="cb-hdr" style="background:rgba(251,146,60,.13)">
          <span class="cb-num" style="color:#fb923c;background:rgba(251,146,60,.2);border-color:rgba(251,146,60,.35)">4</span>
          <span class="cb-titulo" style="color:#fb923c">Atenções</span>
        </div>
        <div class="cb-body">
          <div class="cb-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <ul class="cb-itens">
            <li>
              <span class="cb-itens-dot" style="background:#fb923c"></span>
              <span>Crédito depende das <strong>regras legais</strong></span>
            </li>
            <li>
              <span class="cb-itens-dot" style="background:#fb923c"></span>
              <span>Nota recebida <strong>≠ crédito automático</strong></span>
            </li>
            <li>
              <span class="cb-itens-dot" style="background:#fb923c"></span>
              <span><strong>Cadastro fiscal</strong> e natureza da operação importam</span>
            </li>
            <li>
              <span class="cb-itens-dot" style="background:#fb923c"></span>
              <span>Compras sem direito a crédito impactam <strong>custo / despesa</strong></span>
            </li>
            <li>
              <span class="cb-itens-dot" style="background:#fb923c"></span>
              <span>Parametrização errada gera <strong>tributação errada</strong></span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- ═══ 5. Mapa mental rápido — largura total ═══ -->
    <div class="cb-card">
      <div class="cb-card-top" style="background:linear-gradient(90deg,#22d3ee 0%,rgba(59,130,246,.4) 100%)"></div>
      <div class="cb-hdr" style="background:rgba(34,211,238,.13)">
        <span class="cb-num" style="color:#22d3ee;background:rgba(34,211,238,.2);border-color:rgba(34,211,238,.35)">5</span>
        <span class="cb-titulo" style="color:#22d3ee">Mapa mental rápido</span>
      </div>
      <div class="cb-body">
        <div class="cb-mapa">

          <div class="cb-mapa-row">
            <span class="cb-tag venda">Venda</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">débito do cliente</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">receita bruta</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">IBS/CBS sobre a venda</span>
            <span class="cb-seta">→</span>
            <span class="cb-resultado passivo">Passivo</span>
          </div>

          <div class="cb-mapa-row">
            <span class="cb-tag compra">Compra</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">entrada de mercadoria / insumo</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">IBS/CBS a recuperar</span>
            <span class="cb-seta">→</span>
            <span class="cb-resultado ativo">Ativo</span>
          </div>

          <div class="cb-mapa-row">
            <span class="cb-tag apuracao">Apuração</span>
            <span class="cb-seta">→</span>
            <span class="cb-etapa">compensação entre débito e crédito</span>
            <span class="cb-seta">→</span>
            <span class="cb-resultado saldo">Saldo final</span>
          </div>

        </div>
      </div>
    </div>

  </div>
</Base>
