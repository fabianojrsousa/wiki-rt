<!-- Calendar script using define:vars to inject event data -->
<script define:vars={{ eventosCalendario }}>
  const EVENTOS = eventosCalendario;
  const HOJE_STR = '2026-08-29';
  const MESES_PT = [
    'Janeiro','Fevereiro','Março','Abril','Maio','Junho',
    'Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'
  ];

  let mesAtual = { ano: 2026, mes: 8 };

  function dotColor(ev) {
    if (!ev.confirmado) return 'amarelo';
    if (ev.tipo === 'evento_legislativo' || ev.tipo === 'inicio_vigencia') return 'verde';
    if (ev.tipo === 'marco_tecnico' || ev.tipo === 'entrega_declaracao') return 'azul';
    if (ev.criticidade === 'critica') return 'vermelho';
    return 'azul';
  }

  function renderCalendario(ano, mes) {
    const label = document.getElementById('cal-mes-label');
    if (label) {
      label.textContent = MESES_PT[mes - 1] + ' ' + ano;
    }

    const primeiroDow = new Date(Date.UTC(ano, mes - 1, 1)).getDay();
    const diasNoMes = new Date(Date.UTC(ano, mes, 0)).getUTCDate();

    let html = '';

    for (let i = 0; i < primeiroDow; i++) {
      html += '<div class="cal-cell cal-vazio"></div>';
    }

    for (let d = 1; d <= diasNoMes; d++) {
      const mm = String(mes).padStart(2, '0');
      const dd = String(d).padStart(2, '0');
      const dateStr = ano + '-' + mm + '-' + dd;
      const eventos = EVENTOS[dateStr] || [];
      const ehHoje = dateStr === HOJE_STR;

      let dotsHtml = '';
      if (eventos.length > 0) {
        const cores = eventos.slice(0, 3).map(function(ev) {
          return '<span class="cal-dot cal-dot-' + dotColor(ev) + '"></span>';
        });
        dotsHtml = '<div class="cal-dots">' + cores.join('') + '</div>';
      }

      const titulo = eventos.map(function(e) { return e.titulo; }).join(', ');
      const link = eventos.length > 0 ? eventos[0].slug : null;
      const clickAttr = link ? ' onclick="location.href=\'/marcos/' + link + '\'" style="cursor:pointer"' : '';

      html += '<div class="cal-cell'
        + (ehHoje ? ' cal-hoje' : '')
        + (eventos.length ? ' cal-tem-evento' : '')
        + '"'
        + clickAttr
        + (titulo ? ' title="' + titulo.replace(/"/g, '&quot;') + '"' : '')
        + '>'
        + '<span class="cal-num">' + d + '</span>'
        + dotsHtml
        + '</div>';
    }

    const grid = document.getElementById('cal-grid');
    if (grid) grid.innerHTML = html;
  }

  // Render inicial
  renderCalendario(mesAtual.ano, mesAtual.mes);

  // Navegação
  const btnPrev = document.getElementById('cal-prev');
  const btnNext = document.getElementById('cal-next');
  const btnHoje = document.getElementById('cal-hoje');

  if (btnPrev) btnPrev.addEventListener('click', function() {
    mesAtual.mes--;
    if (mesAtual.mes < 1) { mesAtual.mes = 12; mesAtual.ano--; }
    renderCalendario(mesAtual.ano, mesAtual.mes);
  });
  if (btnNext) btnNext.addEventListener('click', function() {
    mesAtual.mes++;
    if (mesAtual.mes > 12) { mesAtual.mes = 1; mesAtual.ano++; }
    renderCalendario(mesAtual.ano, mesAtual.mes);
  });
  if (btnHoje) btnHoje.addEventListener('click', function() {
    mesAtual = { ano: 2026, mes: 8 };
    renderCalendario(mesAtual.ano, mesAtual.mes);
  });
</script>

