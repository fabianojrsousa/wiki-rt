---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { rotuloData, dia, extenso } from '../lib/datas';

const hoje = new Date('2026-08-29T00:00:00Z');
const limite = new Date(hoje);
limite.setUTCDate(limite.getUTCDate() + 180);

const todosMarcos = await getCollection('marcos');

const proximos = todosMarcos
  .filter((m) => (m.data.data_fim ?? m.data.data_evento) >= hoje && m.data.data_evento <= limite)
  .sort((a, b) => a.data.data_evento.valueOf() - b.data.data_evento.valueOf())
  .slice(0, 5);

const situacoes = await getCollection('situacoes');

const inicio = new Date('2023-07-07T00:00:00Z');
const fim    = new Date('2033-01-01T00:00:00Z');
const progressoPct = Math.max(0, Math.min(100, Math.round(
  (hoje.valueOf() - inicio.valueOf()) / (fim.valueOf() - inicio.valueOf()) * 100
)));

// Eventos por data para o calendário
type EvCal = { criticidade: string; confirmado: boolean; tipo: string; titulo: string; slug: string };
const eventosCalendario: Record<string, EvCal[]> = {};
todosMarcos.forEach((m) => {
  const dateStr = m.data.data_evento.toISOString().slice(0, 10);
  if (!eventosCalendario[dateStr]) eventosCalendario[dateStr] = [];
  eventosCalendario[dateStr].push({
    criticidade: m.data.criticidade,
    confirmado:  m.data.confirmado,
    tipo:        m.data.tipo,
    titulo:      m.data.titulo,
    slug:        m.slug,
  });
  // Marca também o fim do período (ex: janela 01-30/set)
  if (m.data.data_fim) {
    const endStr = m.data.data_fim.toISOString().slice(0, 10);
    if (endStr !== dateStr) {
      if (!eventosCalendario[endStr]) eventosCalendario[endStr] = [];
      eventosCalendario[endStr].push({
        criticidade: m.data.criticidade,
        confirmado:  m.data.confirmado,
        tipo:        'prazo_opcao',
        titulo:      m.data.titulo + ' — fim do prazo',
        slug:        m.slug,
      });
    }
  }
});

// Próximos 4 marcos para sidebar
const proximosSidebar = todosMarcos
  .filter((m) => (m.data.data_fim ?? m.data.data_evento) >= hoje)
  .sort((a, b) => a.data.data_evento.valueOf() - b.data.data_evento.valueOf())
  .slice(0, 4);

const rotuloTipo: Record<string, string> = {
  obrigacao_acessoria: 'OA',
  prazo_opcao:        'Prazo',
  inicio_vigencia:    'Vigência',
  entrega_declaracao: 'Decl.',
  marco_tecnico:      'Técnico',
  evento_legislativo: 'Lei',
  evento_judicial:    'Judicial',
};

function badgeClass(criticidade: string) {
  if (criticidade === 'critica') return 'badge-critico';
  if (criticidade === 'alta')    return 'badge-alto';
  if (criticidade === 'media')   return 'badge-medio';
  return 'badge-info';
}
